# Question 8: Boxplot of MPG vs Cylinders

# Clear previous variables
rm(list = ls())

# Load mtcars dataset
data(mtcars)

# Create boxplot
boxplot(
  mpg ~ cyl,
  data = mtcars,
  main = "Boxplot of MPG vs Number of Cylinders",
  xlab = "Number of Cylinders",
  ylab = "Miles per Gallon (MPG)",
  col = "lightblue"
)
